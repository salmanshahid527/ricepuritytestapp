# Public build-time settings (these values are visible in the page source, so they are not secrets).
# Vercel injected them at build time; Cloudflare builds read them from here.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-56QQ6NHLK2

# Opt-in score statistics. Turn on only after STATS_DATABASE_URL (the Neon connection string) exists as a Worker secret,
# otherwise the results page offers a button that cannot save (the API answers 503).
NEXT_PUBLIC_STATS_ENABLED=1
