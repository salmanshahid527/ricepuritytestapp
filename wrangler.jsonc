{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "ricepuritytestapp",
  "compatibility_date": "2025-12-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "www.ricepuritytestapp.com/*", "zone_name": "ricepuritytestapp.com" },
    { "pattern": "ricepuritytestapp.com/*", "zone_name": "ricepuritytestapp.com" }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "ricepuritytestapp"
    }
  ]
}
